# Security headers for static files (images, scripts, styles, sitemap, llms.txt).
# Pages get the same headers, plus a Content-Security-Policy, from src/server.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Built files have a content hash in their name, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The squad clips and posters keep their names when they change, so browsers check back after a day.
/team/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The merch 3D models are big and rarely change, so browsers keep them for a day and check back after that.
/merch/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The design team's print files: the same, a day and then a check.
/merch/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
