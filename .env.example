NEXT_PUBLIC_SITE_URL=              # public base URL, the only place the address lives
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # safe for the browser, RLS protects the data
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Never in the client. Never committed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=              # server only
REVALIDATE_SECRET=                 # server only, protects the cache refresh route
ABUSE_HASH_SALT_SECRET=            # server only
