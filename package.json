{
  "name": "robio-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:dashes": "sh scripts/check-no-em-dash.sh",
    "test:ik": "node --experimental-strip-types scripts/test-ik.mjs",
    "test:sim": "node --experimental-strip-types scripts/test-sim.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  }
}
